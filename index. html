        }

        function handleInputChange() {
            const val = userInputs.value.trim();
            state.input = val;

            const charLen = val.length;
            const wordLen = val ? val.split(/\s+/).filter(Boolean).length : 0;

            charCount.innerText = `${charLen} chars`;
            wordCount.innerText = `${wordLen} words`;

            if (charLen > 0 && charLen < 10) {
                validationMsg.classList.remove('hidden');
            } else {
                validationMsg.classList.add('hidden');
            }
        }

