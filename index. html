            outputQuiz.classList.add('hidden');
            outputFlashcards.classList.add('hidden');

            copyBtn.disabled = true;
            exportBtn.disabled = true;

            if (view === 'empty') stateEmpty.classList.remove('hidden');
            if (view === 'loading') stateLoading.classList.remove('hidden');
            if (view === 'error') stateError.classList.remove('hidden');
            if (view === 'markdown') {
                outputMarkdown.classList.remove('hidden');
                copyBtn.disabled = false;
                exportBtn.disabled = false;
            }
            if (view === 'quiz') {
                outputQuiz.classList.remove('hidden');
                copyBtn.disabled = false;
            }
            if (view === 'flashcards') {
                outputFlashcards.classList.remove('hidden');
                copyBtn.disabled = false;
            }
        }

        function resetOutputViews() {
            if (!state.isLoading && !state.lastResponseText) {
                setViewState('empty');
            }
        }

        async function fetchGeminiAPI(payload, apiKey = "") {
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
            
            let retries = 3;
            let delay = 1000;

            for (let i = 0; i < retries; i++) {
                try {
                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (!response.ok) {
                        if (response.status === 429) {
                            // Rate limited, retry with exponential backoff
                            await new Promise(res => setTimeout(res, delay));
                            delay *= 2;
                            continue;
                        }
                        const errData = await response.json().catch(() => ({}));
                        throw new Error(errData.error?.message || `API error (${response.status})`);
                    }

                    const data = await response.json();
                    const candidate = data.candidates?.[0];
                    if (!candidate || !candidate.content?.parts?.[0]?.text) {
                        throw new Error("Received an empty or malformed response from the AI model.");
                    }
                    return candidate.content.parts[0].text;
                } catch (err) {
                    if (i === retries - 1) throw err;
                }
            }
        }

        async function handleGenerate() {
            const inputVal = userInputs.value.trim();
            if (inputVal.length < 10) {
                validationMsg.classList.remove('hidden');
                userInputs.focus();
                return;
            }

            state.isLoading = true;
            setViewState('loading');

            let systemPrompt = "You are ScholarAI, an expert academic and career tutor.";
            let userPrompt = inputVal;
            let expectsJson = false;
            let jsonSchema = null;

            // Tailor Prompt according to selected mode
            if (state.currentMode === 'summarize') {
                systemPrompt += " Provide structured, clear summaries with bullet points and key takeaways.";
                userPrompt = `Please summarize the following material (${state.options.summarizeLength} length):\n\n${inputVal}`;
            } else if (state.currentMode === 'quiz') {
                if (state.options.quizType === 'quiz') {
                    expectsJson = true;
                    systemPrompt += " Output ONLY valid JSON representing a quiz with questions, options, and explanations.";
                    userPrompt = `Create a 4-question multiple choice quiz based on this content:\n\n${inputVal}`;
                    jsonSchema = {
                        type: "OBJECT",
                        properties: {
                            quizTitle: { type: "STRING" },
                            questions: {
                                type: "ARRAY",
                                items: {
                                    type: "OBJECT",
                                    properties: {
                                        id: { type: "NUMBER" },
                                        question: { type: "STRING" },
                                        options: { type: "ARRAY", items: { type: "STRING" } },
                                        correctAnswerIdx: { type: "NUMBER" },
                                        explanation: { type: "STRING" }
                                    },
                                    required: ["id", "question", "options", "correctAnswerIdx", "explanation"]
                                }
                            }
                        },
                        required: ["quizTitle", "questions"]
                    };
                } else {
                    expectsJson = true;
                    systemPrompt += " Output ONLY valid JSON for flashcards.";
                    userPrompt = `Create 5 study flashcards (front concept/question and back concise answer) based on:\n\n${inputVal}`;
                    jsonSchema = {
                        type: "OBJECT",
                        properties: {
                            deckTitle: { type: "STRING" },
                            cards: {
                                type: "ARRAY",
                                items: {
                                    type: "OBJECT",
                                    properties: {
                                        front: { type: "STRING" },
                                        back: { type: "STRING" }
                                    },
                                    required: ["front", "back"]
                                }
                            }
                        },
                        required: ["deckTitle", "cards"]
                    };
                }
            } else if (state.currentMode === 'career') {
                if (state.options.careerType === 'resume') {
                    systemPrompt += " Act as a Silicon Valley recruiter. Generate impactful resume bullet points using the Action Verb + Task + Quantifiable Result formula.";
                    userPrompt = `Optimize resume bullet points for this experience/description:\n\n${inputVal}`;
                } else {
                    systemPrompt += " Act as a Senior Technical Hiring Manager. Provide top interview questions, candidate guidance, and STAR framework response examples.";
                    userPrompt = `Provide key interview prep points for:\n\n${inputVal}`;
                }
            } else if (state.currentMode === 'qa') {
                systemPrompt += " Provide clear, pedagogical, step-by-step answers with markdown formatting where appropriate.";
                userPrompt = `Question / Problem:\n${inputVal}`;
            }

            try {
                const payload = {
                    contents: [{ parts: [{ text: userPrompt }] }],
                    systemInstruction: { parts: [{ text: systemPrompt }] }
                };

                if (expectsJson && jsonSchema) {
                    payload.generationConfig = {
                        responseMimeType: "application/json",
                        responseSchema: jsonSchema
                    };
                }

                const responseText = await fetchGeminiAPI(payload);
                state.lastResponseText = responseText;

                if (expectsJson) {
                    const parsed = JSON.parse(responseText);
                    if (state.options.quizType === 'quiz') {
                        state.quizData = parsed;
                        state.userAnswers = {};
                        state.quizScore = 0;
                        renderQuizView();
                        setViewState('quiz');
                    } else {
                        state.flashcardData = parsed;
                        state.activeFlashcardIdx = 0;
                        state.isCardFlipped = false;
                        renderFlashcardView();
                        setViewState('flashcards');
                    }
                } else {
                    outputMarkdown.innerHTML = marked.parse(responseText);
                    setViewState('markdown');
                }
            } catch (err) {
                console.error(err);
                errorMessageText.innerText = err.message || "Failed to communicate with AI model. Please check network.";
                setViewState('error');
            } finally {
                state.isLoading = false;
            }
        }

        function renderQuizView() {
            if (!state.quizData || !state.quizData.questions) return;
            const qData = state.quizData;

            let html = `
                <div class="border-b border-slate-200 dark:border-slate-700 pb-3 mb-4 flex items-center justify-between">
                    <h4 class="font-bold text-base text-slate-800 dark:text-slate-100">${qData.quizTitle || 'Practice Quiz'}</h4>
                    <span class="text-xs font-semibold bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-300 px-2.5 py-1 rounded-full">
                        ${qData.questions.length} Questions
                    </span>
                </div>
                <div class="space-y-6 overflow-y-auto max-h-[480px] pr-2">
            `;

            qData.questions.forEach((q, qIdx) => {
                const userAns = state.userAnswers[qIdx];
                const isAnswered = userAns !== undefined;

                html += `
                    <div class="p-4 bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700/80 rounded-xl space-y-3">
                        <p class="font-semibold text-sm text-slate-800 dark:text-slate-200">${qIdx + 1}. ${q.question}</p>
                        <div class="space-y-2">
                `;

                q.options.forEach((opt, optIdx) => {
                    let optStyle = "border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300";
                    
                    if (isAnswered) {
                        if (optIdx === q.correctAnswerIdx) {
                            optStyle = "border-emerald-500 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 font-semibold";
                        } else if (userAns === optIdx) {
                            optStyle = "border-red-500 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-300";
                        }
                    }

                    html += `
                        <button onclick="selectQuizAnswer(${qIdx}, ${optIdx})" ${isAnswered ? 'disabled' : ''} class="w-full text-left p-3 text-xs rounded-lg border ${optStyle} transition flex items-center justify-between">
                            <span>${opt}</span>
                            ${isAnswered && optIdx === q.correctAnswerIdx ? '<i class="fa-solid fa-circle-check text-emerald-500"></i>' : ''}
                            ${isAnswered && userAns === optIdx && optIdx !== q.correctAnswerIdx ? '<i class="fa-solid fa-circle-xmark text-red-500"></i>' : ''}
                        </button>
                    `;
                });

                if (isAnswered) {
                    html += `
                        <div class="mt-2 p-2.5 bg-blue-50 dark:bg-blue-950/30 text-blue-800 dark:text-blue-300 rounded-lg text-xs border border-blue-100 dark:border-blue-900/50">
                            <strong>Explanation:</strong> ${q.explanation}
                        </div>
                    `;
                }

                html += `</div></div>`;
            });

            html += `</div>`;
            outputQuiz.innerHTML = html;
        }

        window.selectQuizAnswer = function(qIdx, optIdx) {
            state.userAnswers[qIdx] = optIdx;
            renderQuizView();
        };

        function renderFlashcardView() {
            if (!state.flashcardData || !state.flashcardData.cards) return;
            const cards = state.flashcardData.cards;
            const current = cards[state.activeFlashcardIdx];

            let html = `
                <div class="w-full max-w-md flex flex-col items-center gap-4">
                    <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">
                        Card ${state.activeFlashcardIdx + 1} of ${cards.length}
                    </div>

                    <!-- Flip Container -->
                    <div onclick="flipCard()" class="w-full h-60 perspective-1000 cursor-pointer select-none">
                        <div id="flashcard-inner" class="relative w-full h-full duration-500 transform-style-3d ${state.isCardFlipped ? 'rotate-y-180' : ''}">
                            <!-- Front -->
                            <div class="absolute inset-0 w-full h-full bg-white dark:bg-slate-800 border-2 border-blue-500/30 rounded-2xl p-6 shadow-md backface-hidden flex flex-col justify-between items-center text-center">
                                <span class="text-[10px] uppercase font-bold tracking-wider text-blue-500 bg-blue-50 dark:bg-blue-950 px-2 py-0.5 rounded">Front / Concept</span>
                                <p class="font-semibold text-sm sm:text-base text-slate-800 dark:text-slate-100 my-auto">${current.front}</p>
                                <span class="text-[11px] text-slate-400 flex items-center gap-1"><i class="fa-solid fa-rotate"></i> Click to flip</span>
                            </div>

                            <!-- Back -->
                            <div class="absolute inset-0 w-full h-full bg-blue-600 text-white rounded-2xl p-6 shadow-md backface-hidden rotate-y-180 flex flex-col justify-between items-center text-center">
                                <span class="text-[10px] uppercase font-bold tracking-wider text-blue-200 bg-blue-700/50 px-2 py-0.5 rounded">Back / Answer</span>
                                <p class="font-medium text-xs sm:text-sm my-auto leading-relaxed">${current.back}</p>
                                <span class="text-[11px] text-blue-200 flex items-center gap-1"><i class="fa-solid fa-rotate"></i> Click to flip back</span>
                            </div>
                        </div>
                    </div>

                    <!-- Navigation -->
                    <div class="flex items-center gap-4 mt-2">
                        <button onclick="prevCard()" ${state.activeFlashcardIdx === 0 ? 'disabled' : ''} class="p-2.5 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-600 disabled:opacity-40 transition">
                            <i class="fa-solid fa-arrow-left"></i>
                        </button>
                        <button onclick="nextCard()" ${state.activeFlashcardIdx === cards.length - 1 ? 'disabled' : ''} class="p-2.5 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-600 disabled:opacity-40 transition">
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                </div>
            `;
            outputFlashcards.innerHTML = html;
        }

        window.flipCard = function() {
            state.isCardFlipped = !state.isCardFlipped;
            const inner = document.getElementById('flashcard-inner');
            if (inner) inner.classList.toggle('rotate-y-180', state.isCardFlipped);
        };

        window.prevCard = function() {
            if (state.activeFlashcardIdx > 0) {
                state.activeFlashcardIdx--;
                state.isCardFlipped = false;
                renderFlashcardView();
            }
        };

        window.nextCard = function() {
            if (state.flashcardData && state.activeFlashcardIdx < state.flashcardData.cards.length - 1) {
                state.activeFlashcardIdx++;
                state.isCardFlipped = false;
                renderFlashcardView();
            }
        };

        function copyToClipboard() {
            if (!state.lastResponseText) return;
            navigator.clipboard.writeText(state.lastResponseText).then(() => {
                showToast("Content copied to clipboard!");
            }).catch(() => {
                // Fallback using execCommand
                const ta = document.createElement('textarea');
                ta.value = state.lastResponseText;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                showToast("Content copied to clipboard!");
            });
        }

        function exportContent() {
            if (!state.lastResponseText) return;
            const blob = new Blob([state.lastResponseText], { type: 'text/markdown' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `ScholarAI_${state.currentMode}_${Date.now()}.md`;
            a.click();
            URL.revokeObjectURL(url);
            showToast("Exported as Markdown file!");
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-message');
            toastMsg.innerText = msg;
            toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
            }, 3000);
        }

        // Initialize App on DOM load
        window.addEventListener('DOMContentLoaded', initApp);
    </script>
</body>
