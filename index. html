                if (btn.dataset.mode === mode) {
                    btn.className = "tab-btn active-tab flex-1 min-w-[130px] sm:min-w-0 py-2.5 px-3 rounded-lg text-xs sm:text-sm font-semibold bg-white dark:bg-slate-700 text-blue-600 dark:text-blue-400 shadow-sm transition flex items-center justify-center gap-2";
