            modeTitle.innerText = cfg.title;
            modeDesc.innerText = cfg.desc;
            userInputs.placeholder = cfg.placeholder;
            modeOptions.innerHTML = cfg.renderOptions();

            // Bind Options Events
            bindOptionEvents();
            resetOutputViews();
        }

        function bindOptionEvents() {
            // Radio options for summarizer
            document.querySelectorAll('input[name="opt-length"]').forEach(radio => {
                radio.addEventListener('change', (e) => state.options.summarizeLength = e.target.value);
            });

